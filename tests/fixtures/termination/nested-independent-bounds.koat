# Two nested loops whose inner counter is reset from a separate input bound.
(GOAL TERMINATION)
(STARTTERM (FUNCTIONSYMBOLS eval))
(VAR n m i j)
(RULES
  eval(n,m) -> outer(n,m,n,0)
  outer(n,m,i,j) -> inner(n,m,i,m) [i > 0]
  outer(n,m,i,j) -> done(n,m,i,j) [i <= 0]
  inner(n,m,i,j) -> inner(n,m,i,j - 1) [j > 0]
  inner(n,m,i,j) -> outer(n,m,i - 1,j) [j <= 0]
)
