# F#:
# let independentDouble n m =
#   let mutable i = n
#   while i > 0 do
#     let mutable j = m
#     while j > 0 do j <- j - 1
#     i <- i - 1
(GOAL TERMINATION)
(STARTTERM (FUNCTIONSYMBOLS main))
(VAR n m i j)
(RULES
  main(n,m) -> outer(n,m,n,0)
  outer(n,m,i,j) -> inner(n,m,i,m) [i > 0]
  outer(n,m,i,j) -> done(n,m,i,j) [i <= 0]
  inner(n,m,i,j) -> inner(n,m,i,j - 1) [j > 0]
  inner(n,m,i,j) -> outer(n,m,i - 1,j) [j <= 0]
)
