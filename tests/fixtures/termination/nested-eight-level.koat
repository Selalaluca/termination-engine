# Eight nested countdown loops. Exercises the maximum lexicographic removal depth.
(GOAL TERMINATION)
(STARTTERM (FUNCTIONSYMBOLS eval))
(VAR a b c d e f g h)
(RULES
  eval(a) -> level1(a,0,0,0,0,0,0,0)
  level1(a,b,c,d,e,f,g,h) -> level2(a,a,0,0,0,0,0,0) [a > 0]
  level1(a,b,c,d,e,f,g,h) -> done(a,b,c,d,e,f,g,h) [a <= 0]
  level2(a,b,c,d,e,f,g,h) -> level3(a,b,b,0,0,0,0,0) [b > 0]
  level2(a,b,c,d,e,f,g,h) -> level1(a - 1,b,c,d,e,f,g,h) [b <= 0]
  level3(a,b,c,d,e,f,g,h) -> level4(a,b,c,c,0,0,0,0) [c > 0]
  level3(a,b,c,d,e,f,g,h) -> level2(a,b - 1,c,d,e,f,g,h) [c <= 0]
  level4(a,b,c,d,e,f,g,h) -> level5(a,b,c,d,d,0,0,0) [d > 0]
  level4(a,b,c,d,e,f,g,h) -> level3(a,b,c - 1,d,e,f,g,h) [d <= 0]
  level5(a,b,c,d,e,f,g,h) -> level6(a,b,c,d,e,e,0,0) [e > 0]
  level5(a,b,c,d,e,f,g,h) -> level4(a,b,c,d - 1,e,f,g,h) [e <= 0]
  level6(a,b,c,d,e,f,g,h) -> level7(a,b,c,d,e,f,f,0) [f > 0]
  level6(a,b,c,d,e,f,g,h) -> level5(a,b,c,d,e - 1,f,g,h) [f <= 0]
  level7(a,b,c,d,e,f,g,h) -> level8(a,b,c,d,e,f,g,g) [g > 0]
  level7(a,b,c,d,e,f,g,h) -> level6(a,b,c,d,e,f - 1,g,h) [g <= 0]
  level8(a,b,c,d,e,f,g,h) -> level8(a,b,c,d,e,f,g,h - 1) [h > 0]
  level8(a,b,c,d,e,f,g,h) -> level7(a,b,c,d,e,f,g - 1,h) [h <= 0]
)
