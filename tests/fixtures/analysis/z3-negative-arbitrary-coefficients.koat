# Requires a negative weighted direction proportional to 2*y - 3*x.
(GOAL TERMINATION)
(STARTTERM (FUNCTIONSYMBOLS eval))
(VAR x y)
(RULES
  eval(x,y) -> loop(x,y)
  loop(x,y) -> loop(x + 1,y + 1) [2 * y - 3 * x > 0]
  loop(x,y) -> loop(x,y - 1) [2 * y - 3 * x > 0]
  loop(x,y) -> done(x,y) [2 * y - 3 * x <= 0]
)
