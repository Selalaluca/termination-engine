# Requires an unrestricted weighted direction and a nonzero constant.
(GOAL TERMINATION)
(STARTTERM (FUNCTIONSYMBOLS eval))
(VAR x y)
(RULES
  eval(x,y) -> loop(x,y)
  loop(x,y) -> loop(x - 1,y + 1) [3 * x + 2 * y > -10]
  loop(x,y) -> loop(x + 1,y - 2) [3 * x + 2 * y > -10]
  loop(x,y) -> done(x,y) [3 * x + 2 * y <= -10]
)

