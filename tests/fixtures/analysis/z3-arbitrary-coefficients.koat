# The unique smallest direction is rho(x,y) = 3*x + 2*y.
(GOAL TERMINATION)
(STARTTERM (FUNCTIONSYMBOLS eval))
(VAR x y)
(RULES
  eval(x,y) -> loop(x,y)
  loop(x,y) -> loop(x - 1,y + 1) [3 * x + 2 * y > 0]
  loop(x,y) -> loop(x + 1,y - 2) [3 * x + 2 * y > 0]
  loop(x,y) -> done(x,y) [3 * x + 2 * y <= 0]
)
