<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FsLexYacc" Version="11.4.0" PrivateAssets="all" />
    <PackageReference Include="FsLexYacc.Runtime" Version="11.4.0" />
    <PackageReference Include="Microsoft.Z3" Version="4.12.2" />
  </ItemGroup>
  <PropertyGroup>
    <GeneratedParserDir>$(BaseIntermediateOutputPath)Generated\</GeneratedParserDir>
    <FsLexOutputFolder>$(GeneratedParserDir)</FsLexOutputFolder>
    <FsYaccOutputFolder>$(GeneratedParserDir)</FsYaccOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <FsYacc Include="KoatGrammar.fsy"><OtherFlags>--module TerminationEngine.KoatGrammar</OtherFlags></FsYacc>
    <FsLex Include="KoatLexer.fsl"><OtherFlags>--module TerminationEngine.KoatLexer --unicode</OtherFlags></FsLex>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Syntax.fs" />
    <Compile Include="$(GeneratedParserDir)KoatGrammar.fs" />
    <Compile Include="$(GeneratedParserDir)KoatLexer.fs" />
    <Compile Include="KoatParser.fs" />
    <Compile Include="Graph.fs" />
    <Compile Include="Scc.fs" />
    <Compile Include="Components.fs" />
    <Compile Include="ExpressionAnalysis.fs" />
    <Compile Include="NonTermination.fs" />
    <Compile Include="RankingCertificate.fs" />
    <Compile Include="LinearArithmetic.fs" />
    <Compile Include="Smt.fs" />
    <Compile Include="SmtTrace.fs" />
    <Compile Include="Z3Encoding.fs" />
    <Compile Include="Z3Backend.fs" />
    <Compile Include="InvariantAnalysis.fs" />
    <Compile Include="RankingVerification.fs" />
    <Compile Include="RankingSynthesis.fs" />
    <Compile Include="Ranking.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="Report.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
